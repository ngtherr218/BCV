<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.health.READ_STEPS" />
    <!-- Recording API and direct sensor fallback. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepdetector" android:required="false" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <queries>
        <package android:name="com.google.android.apps.healthdata" />
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:theme="@style/Theme.BướcChânViệt">
        <service android:name=".feature.discovery.data.JourneyStepService"
            android:exported="false" android:foregroundServiceType="health" android:stopWithTask="false" />
        <activity android:name=".feature.discovery.presentation.ExploreActivity" android:exported="false" />
        <activity android:name=".feature.discovery.presentation.PlaceDetailActivity" android:exported="false" />
        <activity android:name=".feature.discovery.presentation.RecommendationActivity" android:exported="false" />
        <activity android:name=".feature.journey.presentation.JourneyActivity" android:exported="false" />
        <activity android:name=".feature.collection.presentation.CollectionActivity" android:exported="false" />
        <activity android:name=".feature.collection.presentation.CollectionDetailActivity" android:exported="false" />
        <activity android:name=".feature.collection.presentation.CardDetailActivity" android:exported="false" />
        <activity android:name=".feature.questitem.quest.presentation.QuestActivity" android:exported="false" />
        <activity android:name=".feature.questitem.inventory.presentation.InventoryActivity" android:exported="false" />
        <activity android:name=".feature.questitem.inventory.presentation.SpeedShoesActivity" android:exported="false" />
        <activity android:name=".feature.questitem.inventory.presentation.FlightTicketActivity" android:exported="false" />
        <activity android:name=".feature.account.profile.presentation.ProfileActivity" android:exported="false" />
        <activity android:name=".feature.account.profile.presentation.EditProfileActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".feature.account.profile.presentation.ChangePasswordActivity" android:exported="false" android:windowSoftInputMode="adjustResize" />
        <activity android:name=".feature.discovery.presentation.PlaceVideoActivity" android:exported="false" />
        <activity android:name=".feature.discovery.presentation.CommunityMediaActivity" android:exported="false" />
        <activity android:name=".feature.statsnotify.stats.presentation.StatsActivity" android:exported="false" />
        <activity android:name=".feature.journey.presentation.JourneyHistoryActivity" android:exported="false" />
        <activity android:name=".feature.statsnotify.notifications.presentation.NotificationsActivity" android:exported="false" />
        <activity android:name=".feature.account.healthconnect.presentation.HealthConnectActivity" android:exported="false" />
        <activity android:name=".feature.location.startingpoint.presentation.StartingPointActivity" android:exported="false" />
        <activity android:name=".feature.account.healthconnect.presentation.HealthPermissionRationaleActivity" android:exported="true">
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE" />
            </intent-filter>
        </activity>
        <activity-alias
            android:name=".feature.account.healthconnect.presentation.ViewHealthPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".feature.account.healthconnect.presentation.HealthPermissionRationaleActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE" />
                <category android:name="android.intent.category.HEALTH_PERMISSIONS" />
            </intent-filter>
        </activity-alias>
        <activity android:name=".feature.account.activitylevel.presentation.ActivityLevelActivity" android:exported="false" />
        <activity android:name=".feature.account.interests.presentation.InterestsActivity" android:exported="false" />
        <activity
            android:name=".feature.account.auth.presentation.PasswordResetActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".feature.account.auth.presentation.AccountActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
