<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:background="#FCFCF8">

    <FrameLayout android:layout_width="match_parent" android:layout_height="64dp">
        <ImageButton android:id="@+id/backButton" android:layout_width="48dp"
            android:layout_height="48dp" android:layout_gravity="start|center_vertical"
            android:layout_marginStart="12dp" android:background="@drawable/activity_back_circle"
            android:contentDescription="Quay lại bản đồ" android:padding="12dp"
            android:rotation="180" android:src="@drawable/ic_arrow" app:tint="@color/forest" />
        <TextView android:id="@+id/topTitle" android:layout_width="match_parent" android:layout_height="match_parent"
            android:gravity="center" android:text="Chọn điểm đến" android:textColor="@color/forest"
            android:textSize="17sp" android:textStyle="bold" />
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:fillViewport="true" android:scrollbars="none">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp"
            android:paddingTop="16dp" android:paddingBottom="20dp">

        <!--
          Shown until the place and its first photo are ready: a placeholder shaped like the page that
          will open (locked destination or discovered content), with the name the map already knows.
        -->
        <LinearLayout android:id="@+id/loadingContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:accessibilityLiveRegion="polite"
            android:contentDescription="Đang tải nội dung địa danh" android:orientation="vertical">
            <LinearLayout android:id="@+id/loadingSkeleton" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:orientation="vertical">
                <include android:id="@+id/skeletonLocked" layout="@layout/skeleton_place_detail_locked" />
                <include android:id="@+id/skeletonUnlocked" layout="@layout/skeleton_place_detail_unlocked"
                    android:visibility="gone" />
            </LinearLayout>
            <!-- First load failed: the reason and a retry in place of the placeholder. -->
            <LinearLayout android:id="@+id/loadingError" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:gravity="center_vertical"
                android:orientation="horizontal" android:visibility="gone">
                <TextView android:id="@+id/loadingStatus" android:layout_width="0dp"
                    android:layout_height="wrap_content" android:layout_weight="1"
                    android:accessibilityLiveRegion="polite" android:textColor="@color/error_red"
                    android:textSize="15sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/retryButton"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="Thử lại" android:textAllCaps="false"
                    android:textColor="@color/teal" />
            </LinearLayout>
        </LinearLayout>

        <!--
          One page for every place. Before the walk it is a preview (cover photo, story, fun fact) with
          what the walk unlocks; after it, the full gallery and videos join the same layout.
        -->
        <LinearLayout android:id="@+id/placeContent" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">

            <FrameLayout android:id="@+id/heroCard" android:layout_width="match_parent"
                android:layout_height="280dp" android:background="@drawable/place_hero_empty_bg"
                android:clipToOutline="true">
                <ImageView android:id="@+id/placeImage" android:layout_width="match_parent"
                    android:layout_height="match_parent" android:contentDescription="Ảnh địa danh"
                    android:scaleType="centerCrop" />
                <!-- No photo of this place yet: a calm branded cover instead of a grey box. -->
                <ImageView android:id="@+id/heroPlaceholder" android:layout_width="72dp"
                    android:layout_height="72dp" android:layout_gravity="center"
                    android:layout_marginBottom="40dp" android:alpha="0.55"
                    android:contentDescription="@null" android:src="@drawable/ic_travel_explore"
                    android:visibility="gone" app:tint="@color/white" />
                <View android:layout_width="match_parent" android:layout_height="170dp"
                    android:layout_gravity="bottom" android:background="@drawable/place_hero_gradient" />

                <LinearLayout android:id="@+id/statusTag" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="top|start"
                    android:layout_margin="14dp" android:background="@drawable/place_preview_tag"
                    android:gravity="center_vertical" android:orientation="horizontal"
                    android:paddingStart="10dp" android:paddingTop="6dp" android:paddingEnd="12dp"
                    android:paddingBottom="6dp">
                    <ImageView android:id="@+id/statusIcon" android:layout_width="15dp"
                        android:layout_height="15dp" android:contentDescription="@null"
                        android:src="@drawable/ic_lock" app:tint="@color/forest" />
                    <TextView android:id="@+id/statusText" android:layout_width="wrap_content"
                        android:layout_height="wrap_content" android:layout_marginStart="6dp"
                        android:text="Chưa mở khóa" android:textColor="@color/forest"
                        android:textSize="12sp" android:textStyle="bold" />
                </LinearLayout>
                <TextView android:id="@+id/galleryCounter" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:layout_gravity="top|end"
                    android:layout_margin="14dp" android:background="@drawable/place_counter_bg"
                    android:paddingStart="10dp" android:paddingTop="5dp" android:paddingEnd="10dp"
                    android:paddingBottom="5dp" android:textColor="@color/white" android:textSize="12sp"
                    android:textStyle="bold" android:visibility="gone" />

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_gravity="bottom" android:orientation="vertical"
                    android:paddingStart="18dp" android:paddingEnd="18dp" android:paddingBottom="16dp">
                    <TextView android:id="@+id/placeName" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:accessibilityHeading="true"
                        android:ellipsize="end" android:maxLines="2" android:shadowColor="#66000000"
                        android:shadowRadius="6" android:textColor="@color/white" android:textSize="26sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/regionText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:drawableStart="@drawable/ic_note_pin" android:drawablePadding="6dp"
                        android:drawableTint="#E6FFFFFF" android:gravity="center_vertical"
                        android:maxLines="1" android:ellipsize="end" android:textColor="#E6FFFFFF"
                        android:textSize="15sp" />
                </LinearLayout>
            </FrameLayout>

            <!-- Other photos of the place (unlocked only). -->
            <HorizontalScrollView android:id="@+id/galleryThumbRow" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="12dp"
                android:scrollbars="none" android:visibility="gone">
                <LinearLayout android:id="@+id/galleryThumbs" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- At a glance: rating, walk, kind of place. -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:baselineAligned="false"
                android:orientation="horizontal">
                <LinearLayout style="@style/PlaceStat" android:layout_marginEnd="8dp">
                    <TextView android:id="@+id/ratingValue" style="@style/PlaceStatValue" />
                    <TextView android:id="@+id/ratingLabel" style="@style/PlaceStatLabel" />
                </LinearLayout>
                <LinearLayout style="@style/PlaceStat" android:layout_marginEnd="8dp">
                    <TextView android:id="@+id/distanceText" style="@style/PlaceStatValue" />
                    <TextView android:id="@+id/stepsText" style="@style/PlaceStatLabel" />
                </LinearLayout>
                <LinearLayout style="@style/PlaceStat">
                    <TextView android:id="@+id/placeTypeText" style="@style/PlaceStatValue"
                        android:maxLines="2" android:textSize="15sp" />
                    <TextView style="@style/PlaceStatLabel" android:text="Loại hình" />
                </LinearLayout>
            </LinearLayout>

            <!-- Locked: what walking here unlocks. -->
            <LinearLayout android:id="@+id/unlockCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="16dp"
                android:background="@drawable/place_unlock_bg" android:orientation="vertical"
                android:padding="16dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="Đi bộ đến đây để mở khóa" android:textColor="#6B4A10"
                    android:textSize="17sp" android:textStyle="bold" />
                <TextView android:id="@+id/unlockHint" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="2dp"
                    android:textColor="#8F7440" android:textSize="13sp" />
                <TextView style="@style/PlaceUnlockRow" android:drawableStart="@drawable/ic_visibility"
                    android:text="Bộ ảnh đầy đủ và video" />
                <TextView style="@style/PlaceUnlockRow" android:drawableStart="@drawable/ic_nav_collection"
                    android:text="Thẻ sưu tập của địa danh" />
                <TextView style="@style/PlaceUnlockRow" android:drawableStart="@drawable/ic_quiz"
                    android:text="Điểm khám phá và trạm câu hỏi" />
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="24dp" android:accessibilityHeading="true"
                android:text="Giới thiệu" android:textColor="@color/forest" android:textSize="20sp"
                android:textStyle="bold" />
            <TextView android:id="@+id/storyText" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="8dp"
                android:lineSpacingExtra="5dp" android:textColor="#4F6559" android:textSize="15sp" />

            <LinearLayout android:id="@+id/factCard" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:background="@drawable/place_highlight_warm_bg" android:orientation="horizontal"
                android:padding="16dp">
                <ImageView android:layout_width="24dp" android:layout_height="24dp"
                    android:importantForAccessibility="no" android:src="@drawable/ic_m3_lightbulb"
                    app:tint="#C9962B" />
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="Bạn có biết?" android:textColor="@color/forest" android:textSize="15sp"
                        android:textStyle="bold" />
                    <TextView android:id="@+id/factText" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:layout_marginTop="4dp"
                        android:lineSpacingExtra="3dp" android:textColor="#5F7468" android:textSize="15sp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout android:id="@+id/officialVideos" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="20dp"
                android:orientation="vertical" android:visibility="gone" />
        </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout android:id="@+id/bottomBar" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:visibility="gone" android:background="@drawable/place_bottom_bar_bg"
        android:orientation="horizontal" android:baselineAligned="false" android:gravity="center_vertical"
        android:paddingStart="20dp" android:paddingTop="12dp"
        android:paddingEnd="20dp" android:paddingBottom="16dp">
        <!-- Unlocked: private journal. Locked: pick as destination. Both: real-world GPS check-in. -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/checkinButton" style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1"
            android:layout_marginEnd="10dp" android:text="Check-in" android:textAllCaps="false"
            android:maxLines="1" android:paddingStart="8dp" android:paddingEnd="8dp" app:iconPadding="4dp"
            android:textColor="@color/teal" android:textStyle="bold" app:cornerRadius="16dp"
            app:strokeColor="#CFE0D6" app:icon="@drawable/ic_starting_pin" app:iconTint="@color/teal"
            app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/communityMediaButton" style="@style/Widget.Material3.Button"
            android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1.4"
            android:text="Nhật ký" android:textAllCaps="false" android:textStyle="bold"
            app:backgroundTint="@color/teal" app:cornerRadius="16dp"
            app:icon="@drawable/ic_journal_book" app:iconGravity="textStart" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/selectButton" style="@style/Widget.Material3.Button"
            android:layout_width="0dp" android:layout_height="54dp" android:layout_weight="1.4"
            android:enabled="false" android:text="Chọn làm điểm đến" android:textAllCaps="false"
            android:textSize="15sp" android:textStyle="bold" app:backgroundTint="@color/place_primary_button"
            app:cornerRadius="16dp" />
    </LinearLayout>
</LinearLayout>
