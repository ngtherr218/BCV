<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:background="@color/tab_screen_bg">
 <include android:id="@+id/topBar" layout="@layout/view_detail_top_bar"/>
 <include android:id="@+id/state" layout="@layout/view_screen_state"/>
 <ScrollView android:id="@+id/content" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true" android:scrollbars="none" android:visibility="gone">
  <LinearLayout android:id="@+id/completionBody" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingTop="12dp" android:paddingBottom="32dp">
   <ImageView android:id="@+id/successIcon" android:layout_width="64dp" android:layout_height="64dp" android:layout_gravity="center_horizontal" android:src="@drawable/ic_check_circle" android:contentDescription="Hành trình đã được xác nhận hoàn thành" app:tint="@color/teal"/>
   <TextView android:id="@+id/successTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:text="Chinh phục thành công!" android:gravity="center" android:textColor="@color/forest" android:textSize="28sp" android:textStyle="bold" android:accessibilityHeading="true"/>
   <TextView android:id="@+id/successMessage" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:textColor="#526A5E" android:textSize="15sp" android:lineSpacingExtra="4dp"/>
   <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/field_line" app:cardBackgroundColor="@color/white">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
     <ImageView android:id="@+id/placeImage" android:layout_width="match_parent" android:layout_height="156dp" android:scaleType="centerInside" android:background="@color/field_bg" android:src="@drawable/ic_place_outline" android:padding="48dp" android:contentDescription="Ảnh địa danh" app:tint="#A7BBB0"/>
     <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="18dp" android:orientation="vertical">
      <TextView android:id="@+id/placeName" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/forest" android:textSize="20sp" android:textStyle="bold"/>
      <TextView android:id="@+id/regionName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="#62786D" android:textSize="14sp"/>
     </LinearLayout>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <com.google.android.material.card.MaterialCardView android:id="@+id/cardSection" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:visibility="gone" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/field_line" app:cardBackgroundColor="@color/field_bg">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:padding="16dp">
     <ImageView android:id="@+id/cardImage" android:layout_width="80dp" android:layout_height="112dp" android:scaleType="centerInside" android:background="@drawable/card_image_bg" android:padding="16dp" android:src="@drawable/ic_place_outline" android:contentDescription="Ảnh thẻ sưu tập" app:tint="#A7BBB0"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="16dp" android:orientation="vertical">
      <TextView android:id="@+id/cardTitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/teal" android:textSize="12sp" android:textStyle="bold"/>
      <TextView android:id="@+id/cardName" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/forest" android:textSize="17sp" android:textStyle="bold"/>
      <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="Thẻ đã được lưu vào bộ sưu tập của bạn." android:textColor="#526A5E" android:textSize="13sp" android:lineSpacingExtra="3dp"/>
     </LinearLayout>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:orientation="horizontal" android:baselineAligned="false">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:padding="16dp" android:background="@drawable/journey_card_bg">
     <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_directions_walk" android:contentDescription="@null" app:tint="@color/teal"/>
     <TextView android:id="@+id/stepsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/forest"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Bước hành trình" android:textSize="13sp" android:textColor="#62786D"/>
    </LinearLayout>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="12dp" android:orientation="vertical" android:padding="16dp" android:background="@drawable/journey_card_bg">
     <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/ic_task_alt" android:contentDescription="@null" app:tint="@color/teal"/>
     <TextView android:id="@+id/pointsValue" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:textSize="24sp" android:textStyle="bold" android:textColor="@color/teal"/>
     <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="Điểm nhận được" android:textSize="13sp" android:textColor="#62786D"/>
    </LinearLayout>
   </LinearLayout>
   <TextView android:id="@+id/receiptNote" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Điểm khám phá đã ghi nhận. Điểm nhiệm vụ được hiển thị riêng tại mục Nhiệm vụ." android:textSize="12sp" android:textColor="#62786D" android:lineSpacingExtra="3dp"/>
   <TextView android:id="@+id/completedTime" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:textSize="12sp" android:textColor="#62786D"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/viewPlaceButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:minHeight="52dp" android:text="Xem địa danh" android:textAllCaps="false" android:textSize="15sp" android:insetTop="0dp" android:insetBottom="0dp" app:cornerRadius="14dp"/>
   <com.google.android.material.button.MaterialButton android:id="@+id/continueButton" style="@style/Widget.MaterialComponents.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:minHeight="52dp" android:text="Tiếp tục khám phá" android:textAllCaps="false" android:textSize="15sp" app:cornerRadius="14dp"/>
  </LinearLayout>
 </ScrollView>
</LinearLayout>
