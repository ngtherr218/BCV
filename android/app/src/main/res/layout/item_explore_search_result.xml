<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="8dp">
    <ImageView
        android:id="@+id/resultIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/explore_header_circle"
        android:importantForAccessibility="no"
        android:padding="10dp"
        android:src="@drawable/ic_starting_pin"
        app:tint="@color/teal" />
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">
        <TextView
            android:id="@+id/resultName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/forest"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/resultMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#7C9086"
            android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/resultBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:background="@drawable/explore_search_box_bg"
        android:paddingHorizontal="8dp"
        android:paddingVertical="3dp"
        android:text="Đã khám phá"
        android:textColor="@color/teal"
        android:textSize="11sp"
        android:textStyle="bold" />
</LinearLayout>
