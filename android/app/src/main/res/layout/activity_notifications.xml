<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/tab_screen_bg"
    android:orientation="vertical">

    <include
        android:id="@+id/topBar"
        layout="@layout/view_detail_top_bar" />

    <include
        android:id="@+id/state"
        layout="@layout/view_screen_state" />

    <include
        android:id="@+id/skeleton"
        layout="@layout/skeleton_notifications" />

    <ScrollView
        android:id="@+id/content"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="none"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="8dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <!-- One compact header row: how many are unread, then the two bulk actions. -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/unreadChip"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:textColor="@color/forest"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/markAllReadButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="Đọc hết"
                    android:textAllCaps="false"
                    android:textColor="@color/teal"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_m3_check"
                    app:iconSize="18dp"
                    app:iconTint="@color/teal" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/deleteAllButton"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:insetTop="0dp"
                    android:insetBottom="0dp"
                    android:minWidth="0dp"
                    android:text="Xoá"
                    android:textAllCaps="false"
                    android:textColor="#B4483F"
                    android:textSize="13sp"
                    app:icon="@drawable/ic_delete_outline"
                    app:iconSize="18dp"
                    app:iconTint="#B4483F" />
            </LinearLayout>

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:gravity="center"
                android:textColor="#7C9086"
                android:textSize="13sp"
                android:visibility="gone" />

            <!-- Grouped by day: a small date label, then one rounded card holding that day's rows. -->
            <LinearLayout
                android:id="@+id/notificationList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
