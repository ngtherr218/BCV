<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Place page: three equal "at a glance" tiles under the hero photo. -->
    <style name="PlaceStat">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:minHeight">78dp</item>
        <item name="android:background">@drawable/place_stat_bg</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">12dp</item>
    </style>
    <style name="PlaceStatValue">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
        <item name="android:textColor">@color/forest</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="PlaceStatLabel">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:maxLines">2</item>
        <item name="android:textColor">#7C9086</item>
        <item name="android:textSize">12sp</item>
    </style>
    <style name="PlaceUnlockRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">12dp</item>
        <item name="android:drawablePadding">12dp</item>
        <item name="android:drawableTint">#B07A1C</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:textColor">#5A4520</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
